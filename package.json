{
  "name": "iobroker.ham",
  "version": "5.3.1",
  "description": "Homebridge accessories manager",
  "author": {
    "name": "Apollon77",
    "email": "ingo@fischer-ka.de"
  },
  "contributors": [
    {
      "name": "Apollon77",
      "email": "ingo@fischer-ka.de"
    },
    {
      "name": "Kirov Ilya",
      "email": "kirovilya@gmail.com"
    }
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.ham",
  "keywords": [
    "ioBroker",
    "Homebridge",
    "Smart Home",
    "home automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioBroker/ioBroker.ham.git"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.ham/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "homebridge-plugin-wrapper": "^3.2.0",
    "string-argv": "^0.3.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build-backend": "tsc -p tsconfig.build.json",
    "check-admin": "tsc -p src-admin/tsconfig.json",
    "lint-admin": "cd src-admin && npm run lint",
    "build": "npm run build-backend && npm run check-admin && ts-node --project tsconfig.tasks.json tasks.ts",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "check-tasks": "tsc -p tsconfig.tasks.json",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:unit": "mocha \"test/unit/**/*.test.js\" --exit",
    "test-admin": "cd src-admin && npm test",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package && npm run test:unit",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-admin && npm i -f",
    "0-clean": "ts-node --project tsconfig.tasks.json tasks.ts --0-clean",
    "1-npm": "ts-node --project tsconfig.tasks.json tasks.ts --1-npm",
    "2-build": "ts-node --project tsconfig.tasks.json tasks.ts --2-build",
    "3-copy": "ts-node --project tsconfig.tasks.json tasks.ts --3-copy",
    "4-patch": "ts-node --project tsconfig.tasks.json tasks.ts --4-patch"
  }
}
